---
import { getSortedTracks } from '../data/music';

const musicTracks = getSortedTracks();
---

<section id="music" class="relative w-full py-24 bg-[#111111] overflow-hidden">
    <!-- Elementos decorativos de fondo -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl"></div>
    
    <!-- Header de la sección -->
    <div class="container mx-auto px-6 mb-16">
        <div class="text-center">
            <span class="inline-block text-purple-400 text-sm font-bold tracking-[0.3em] uppercase mb-4 font-montserrat">
                Escucha nuestros éxitos
            </span>
            <h2 class="text-5xl md:text-7xl font-bold text-white italic tracking-wider font-auriol mb-4">
                Nuestra Música
            </h2>
            <div class="w-24 h-1 bg-gradient-to-r from-purple-500 to-blue-500 mx-auto rounded-full"></div>
            <p class="text-gray-400 text-lg mt-6 max-w-2xl mx-auto">
                Canciones que reflejan lo romántico, bohemio y actual de nuestra esencia
            </p>
        </div>
    </div>

    <!-- Carrusel Container -->
    <div class="relative carousel-container">
        
        <!-- Botón Izquierdo - Solo en desktop -->
        <button 
            id="carousel-prev"
            class="hidden md:flex absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 w-14 h-14 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 hover:border-white/40 rounded-full items-center justify-center text-white transition-all duration-300 hover:scale-110 group"
            aria-label="Anterior"
        >
            <i class="ri-arrow-left-s-line text-2xl group-hover:-translate-x-0.5 transition-transform" aria-hidden="true"></i>
        </button>

        <!-- Botón Derecho - Solo en desktop -->
        <button 
            id="carousel-next"
            class="hidden md:flex absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 w-14 h-14 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 hover:border-white/40 rounded-full items-center justify-center text-white transition-all duration-300 hover:scale-110 group"
            aria-label="Siguiente"
        >
            <i class="ri-arrow-right-s-line text-2xl group-hover:translate-x-0.5 transition-transform" aria-hidden="true"></i>
        </button>

        <!-- Gradientes laterales para efecto fade -->
        <div class="absolute left-0 top-0 w-16 md:w-32 h-full bg-gradient-to-r from-[#111111] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 w-16 md:w-32 h-full bg-gradient-to-l from-[#111111] to-transparent z-10 pointer-events-none"></div>
        
        <!-- Carrusel con scroll horizontal -->
        <div class="carousel-wrapper overflow-x-auto scrollbar-hide py-8 px-6 md:px-16" id="carousel-wrapper">
            <div class="carousel-track flex gap-6" id="carousel-track">
                {musicTracks.map((track) => (
                    <div class="carousel-item flex-shrink-0 w-72 md:w-80 group">
                        <div class="relative bg-white/5 backdrop-blur-sm rounded-3xl p-5 border border-white/10 hover:border-white/30 transition-all duration-500 hover:scale-[1.02] hover:bg-white/10 h-full">
                            
                            <!-- Glow effect on hover -->
                            <div class="absolute -inset-1 bg-gradient-to-r from-purple-500/20 to-blue-500/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            
                            <div class="relative">
                                <!-- Cover Image -->
                                <div class="relative mb-5 overflow-hidden rounded-2xl">
                                    <img 
                                        src={track.cover} 
                                        alt={`Portada de ${track.title}`}
                                        class="w-full aspect-square object-cover transition-transform duration-700 group-hover:scale-110"
                                        loading="lazy"
                                        width="320"
                                        height="320"
                                        draggable="false"
                                    />
                                    
                                    <!-- Overlay gradiente -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                    
                                    <!-- Play Button Overlay -->
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                                        <div class="w-16 h-16 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center transform scale-50 group-hover:scale-100 transition-transform duration-300 shadow-2xl">
                                            <i class="ri-play-fill text-3xl text-[#111111] ml-1" aria-hidden="true"></i>
                                        </div>
                                    </div>

                                    <!-- Featured Badge -->
                                    {track.featured && (
                                        <div class="absolute top-3 left-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white text-xs px-3 py-1.5 rounded-full font-bold uppercase tracking-wider shadow-lg">
                                            <i class="ri-star-fill mr-1" aria-hidden="true"></i>
                                            Destacado
                                        </div>
                                    )}
                                </div>

                                <!-- Track Info -->
                                <div class="space-y-3">
                                    <h3 class="text-xl font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-purple-400 group-hover:to-blue-400 transition-all duration-300">
                                        {track.title}
                                    </h3>
                                    <div class="flex items-center justify-between">
                                        <p class="text-gray-400 text-sm font-medium">
                                            {track.artist || 'Owen'}
                                        </p>
                                        {track.duration && (
                                            <span class="text-gray-500 text-xs bg-white/5 px-2 py-1 rounded-lg">
                                                <i class="ri-time-line mr-1" aria-hidden="true"></i>
                                                {track.duration}
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <!-- Platform Links -->
                                <div class="flex gap-3 mt-5">
                                    {track.links.youtube && (
                                        <a 
                                            href={track.links.youtube}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-red-500/25"
                                            aria-label={`Escuchar ${track.title} en YouTube`}
                                        >
                                            <i class="ri-youtube-fill text-lg" aria-hidden="true"></i>
                                            YouTube
                                        </a>
                                    )}
                                    {track.links.spotify && (
                                        <a 
                                            href={track.links.spotify}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-gradient-to-r from-green-600 to-green-500 hover:from-green-500 hover:to-green-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-green-500/25"
                                            aria-label={`Escuchar ${track.title} en Spotify`}
                                        >
                                            <i class="ri-spotify-fill text-lg" aria-hidden="true"></i>
                                            Spotify
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Indicadores de posición -->
    <div class="flex justify-center mt-8 gap-2" id="carousel-dots">
        {musicTracks.map((_, index) => (
            <button 
                class="carousel-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50"
                data-index={index}
                aria-label={`Ir a canción ${index + 1}`}
            ></button>
        ))}
    </div>

    <!-- Indicador de swipe - Solo en móviles -->
    <div class="flex md:hidden justify-center mt-4">
        <div class="flex items-center gap-2 text-gray-500 text-sm">
            <i class="ri-hand-coin-line" aria-hidden="true"></i>
            <span>Desliza para ver más</span>
        </div>
    </div>
</section>

<style>
    /* Ocultar scrollbar pero mantener funcionalidad */
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    /* Scroll suave */
    .carousel-wrapper {
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }

    .carousel-item {
        scroll-snap-align: center;
    }

    /* Dot activo */
    .carousel-dot.active {
        width: 2rem;
        background: linear-gradient(to right, #8b5cf6, #3b82f6);
    }
</style>

<script>
    // Optimized carousel script with performance improvements
    const initCarousel = () => {
        const wrapper = document.getElementById('carousel-wrapper');
        const prevBtn = document.getElementById('carousel-prev');
        const nextBtn = document.getElementById('carousel-next');
        const dots = document.querySelectorAll('.carousel-dot');
        const items = document.querySelectorAll('.carousel-item');
        
        if (!wrapper || items.length === 0) return;

        let currentIndex = 0;
        let isScrolling = false;

        // Optimized item width calculation
        const getItemWidth = () => {
            const item = items[0] as HTMLElement;
            return item.offsetWidth + 24; // width + gap
        };

        // Throttled dot update function
        const updateDots = (() => {
            let timeout: number | undefined;
            return () => {
                if (timeout) return;
                timeout = window.setTimeout(() => {
                    const itemWidth = getItemWidth();
                    const scrollPosition = wrapper.scrollLeft;
                    const newIndex = Math.round(scrollPosition / itemWidth);
                    
                    dots.forEach((dot, index) => {
                        dot.classList.toggle('active', index === newIndex);
                    });
                    
                    currentIndex = Math.max(0, Math.min(newIndex, items.length - 1));
                    timeout = undefined;
                }, 16); // ~60fps
            };
        })();

        // Smooth scroll to index
        const scrollToIndex = (index: number) => {
            if (isScrolling) return;
            
            const maxIndex = items.length - 1;
            index = Math.max(0, Math.min(index, maxIndex));
            const itemWidth = getItemWidth();
            
            isScrolling = true;
            wrapper.scrollTo({
                left: index * itemWidth,
                behavior: 'smooth'
            });
            
            currentIndex = index;
            setTimeout(() => { isScrolling = false; }, 300);
        };

        // Event listeners with passive scrolling
        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => scrollToIndex(currentIndex - 1));
            nextBtn.addEventListener('click', () => scrollToIndex(currentIndex + 1));
        }

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => scrollToIndex(index));
        });

        wrapper.addEventListener('scroll', updateDots, { passive: true });

        // Initialize
        updateDots();

        // Resize handler with debounce
        let resizeTimeout: number | undefined;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = window.setTimeout(updateDots, 150);
        }, { passive: true });
    };

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCarousel);
    } else {
        initCarousel();
    }
</script>