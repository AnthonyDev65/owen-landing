---
import { getSortedTracks } from '../data/music';

const musicTracks = getSortedTracks();
---

<section id="music" class="relative w-full py-24 bg-[#111111] overflow-hidden">
    <!-- Elementos decorativos de fondo -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl"></div>
    
    <!-- Header de la sección -->
    <div class="container mx-auto px-6 mb-16">
        <div class="text-center">
            <span class="inline-block text-purple-400 text-sm font-bold tracking-[0.3em] uppercase mb-4 font-montserrat">
                Escucha nuestros éxitos
            </span>
            <h2 class="text-5xl md:text-7xl font-bold text-white italic tracking-wider font-auriol mb-4">
                Nuestra Música
            </h2>
            <div class="w-24 h-1 bg-linear-to-r from-purple-500 to-blue-500 mx-auto rounded-full"></div>
            <p class="text-gray-400 text-lg mt-6 max-w-2xl mx-auto">
                Canciones que reflejan lo romántico, bohemio y actual de nuestra esencia
            </p>
        </div>
    </div>

    <!-- Carrusel Container -->
    <div class="relative carousel-container">
        <!-- Gradientes laterales para efecto fade -->
        <div class="absolute left-0 top-0 w-32 h-full bg-linear-to-r from-[#111111] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 w-32 h-full bg-linear-to-l from-[#111111] to-transparent z-10 pointer-events-none"></div>
        
        <!-- Carrusel con animación infinita -->
        <div class="overflow-hidden py-8">
            <div class="carousel-track-wrapper">
                <!-- Primera copia -->
                {musicTracks.map((track) => (
                    <div class="carousel-item group">
                        <div class="relative bg-white/5 backdrop-blur-sm rounded-3xl p-5 border border-white/10 hover:border-white/30 transition-all duration-500 hover:scale-105 hover:bg-white/10 h-full">
                            
                            <!-- Glow effect on hover -->
                            <div class="absolute -inset-1 bg-linear-to-r from-purple-500/20 to-blue-500/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            
                            <div class="relative">
                                <!-- Cover Image -->
                                <div class="relative mb-5 overflow-hidden rounded-2xl">
                                    <img 
                                        src={track.cover} 
                                        alt={`Portada de ${track.title}`}
                                        class="w-full aspect-square object-cover transition-transform duration-700 group-hover:scale-110"
                                    />
                                    
                                    <!-- Overlay gradiente -->
                                    <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                    
                                    <!-- Play Button Overlay -->
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                                        <div class="w-16 h-16 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center transform scale-50 group-hover:scale-100 transition-transform duration-300 shadow-2xl">
                                            <i class="ri-play-fill text-3xl text-[#111111] ml-1" aria-hidden="true"></i>
                                        </div>
                                    </div>

                                    <!-- Featured Badge -->
                                    {track.featured && (
                                        <div class="absolute top-3 left-3 bg-linear-to-r from-purple-600 to-blue-600 text-white text-xs px-3 py-1.5 rounded-full font-bold uppercase tracking-wider shadow-lg">
                                            <i class="ri-star-fill mr-1" aria-hidden="true"></i>
                                            Destacado
                                        </div>
                                    )}
                                </div>

                                <!-- Track Info -->
                                <div class="space-y-3">
                                    <h3 class="text-xl font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-linear-to-r group-hover:from-purple-400 group-hover:to-blue-400 transition-all duration-300">
                                        {track.title}
                                    </h3>
                                    <div class="flex items-center justify-between">
                                        <p class="text-gray-400 text-sm font-medium">
                                            {track.artist || 'Owen'}
                                        </p>
                                        {track.duration && (
                                            <span class="text-gray-500 text-xs bg-white/5 px-2 py-1 rounded-lg">
                                                <i class="ri-time-line mr-1" aria-hidden="true"></i>
                                                {track.duration}
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <!-- Platform Links -->
                                <div class="flex gap-3 mt-5">
                                    {track.links.youtube && (
                                        <a 
                                            href={track.links.youtube}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-linear-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-red-500/25 hover:scale-105"
                                            aria-label={`Escuchar ${track.title} en YouTube`}
                                        >
                                            <i class="ri-youtube-fill text-lg" aria-hidden="true"></i>
                                            YouTube
                                        </a>
                                    )}
                                    {track.links.spotify && (
                                        <a 
                                            href={track.links.spotify}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-linear-to-r from-green-600 to-green-500 hover:from-green-500 hover:to-green-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-green-500/25 hover:scale-105"
                                            aria-label={`Escuchar ${track.title} en Spotify`}
                                        >
                                            <i class="ri-spotify-fill text-lg" aria-hidden="true"></i>
                                            Spotify
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
                <!-- Segunda copia para loop infinito -->
                {musicTracks.map((track) => (
                    <div class="carousel-item group">
                        <div class="relative bg-white/5 backdrop-blur-sm rounded-3xl p-5 border border-white/10 hover:border-white/30 transition-all duration-500 hover:scale-105 hover:bg-white/10 h-full">
                            
                            <div class="absolute -inset-1 bg-linear-to-r from-purple-500/20 to-blue-500/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            
                            <div class="relative">
                                <div class="relative mb-5 overflow-hidden rounded-2xl">
                                    <img 
                                        src={track.cover} 
                                        alt={`Portada de ${track.title}`}
                                        class="w-full aspect-square object-cover transition-transform duration-700 group-hover:scale-110"
                                    />
                                    
                                    <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                    
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                                        <div class="w-16 h-16 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center transform scale-50 group-hover:scale-100 transition-transform duration-300 shadow-2xl">
                                            <i class="ri-play-fill text-3xl text-[#111111] ml-1" aria-hidden="true"></i>
                                        </div>
                                    </div>

                                    {track.featured && (
                                        <div class="absolute top-3 left-3 bg-linear-to-r from-purple-600 to-blue-600 text-white text-xs px-3 py-1.5 rounded-full font-bold uppercase tracking-wider shadow-lg">
                                            <i class="ri-star-fill mr-1" aria-hidden="true"></i>
                                            Destacado
                                        </div>
                                    )}
                                </div>

                                <div class="space-y-3">
                                    <h3 class="text-xl font-bold text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-linear-to-r group-hover:from-purple-400 group-hover:to-blue-400 transition-all duration-300">
                                        {track.title}
                                    </h3>
                                    <div class="flex items-center justify-between">
                                        <p class="text-gray-400 text-sm font-medium">
                                            {track.artist || 'Owen'}
                                        </p>
                                        {track.duration && (
                                            <span class="text-gray-500 text-xs bg-white/5 px-2 py-1 rounded-lg">
                                                <i class="ri-time-line mr-1" aria-hidden="true"></i>
                                                {track.duration}
                                            </span>
                                        )}
                                    </div>
                                </div>

                                <div class="flex gap-3 mt-5">
                                    {track.links.youtube && (
                                        <a 
                                            href={track.links.youtube}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-linear-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-red-500/25 hover:scale-105"
                                            aria-label={`Escuchar ${track.title} en YouTube`}
                                        >
                                            <i class="ri-youtube-fill text-lg" aria-hidden="true"></i>
                                            YouTube
                                        </a>
                                    )}
                                    {track.links.spotify && (
                                        <a 
                                            href={track.links.spotify}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 bg-linear-to-r from-green-600 to-green-500 hover:from-green-500 hover:to-green-400 text-white py-3 px-4 rounded-xl text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2 hover:shadow-lg hover:shadow-green-500/25 hover:scale-105"
                                            aria-label={`Escuchar ${track.title} en Spotify`}
                                        >
                                            <i class="ri-spotify-fill text-lg" aria-hidden="true"></i>
                                            Spotify
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Indicador de scroll - solo en desktop -->
    <div class="hidden md:flex justify-center mt-8 gap-2">
        <div class="flex items-center gap-2 text-gray-500 text-sm">
            <i class="ri-mouse-line" aria-hidden="true"></i>
            <span>Pasa el mouse para pausar</span>
        </div>
    </div>
</section>

<style>
    .carousel-track-wrapper {
        display: flex;
        gap: 2rem;
        width: fit-content;
        animation: scrollCarousel 30s linear infinite !important;
    }

    .carousel-item {
        flex-shrink: 0;
        width: 320px;
    }

    @keyframes scrollCarousel {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    .carousel-container:hover .carousel-track-wrapper {
        animation-play-state: paused !important;
    }

    @media (max-width: 768px) {
        .carousel-item {
            width: 280px;
        }
        .carousel-track-wrapper {
            animation-duration: 20s !important;
        }
    }
</style>

<script>
    // Click en la tarjeta abre YouTube
    document.querySelectorAll('.carousel-item').forEach(item => {
        item.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (!target.closest('a')) {
                const youtubeLink = item.querySelector('a[href*="youtube"]') as HTMLAnchorElement;
                if (youtubeLink) {
                    window.open(youtubeLink.href, '_blank');
                }
            }
        });
    });
</script>