---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  quality?: number;
}

const { 
  src, 
  alt, 
  width, 
  height, 
  class: className = '', 
  loading = 'lazy',
  sizes = '100vw',
  quality = 85
} = Astro.props;

// Generar diferentes tamaños para responsive
const widths = [320, 640, 768, 1024, 1280, 1920];
const formats = ['webp', 'jpg'];
---

<picture>
  {formats.map(format => (
    <source
      type={`image/${format}`}
      srcset={widths.map(w => 
        `/_image?href=${encodeURIComponent(src)}&w=${w}&f=${format}&q=${quality} ${w}w`
      ).join(', ')}
      sizes={sizes}
    />
  ))}
  <img
    src={`/_image?href=${encodeURIComponent(src)}&w=${width || 800}&f=jpg&q=${quality}`}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    decoding="async"
  />
</picture>