---
import { getSortedTeamMembers } from '../data/team';

const sortedTeamMembers = getSortedTeamMembers();
---

<section id="team" class="relative min-h-screen py-24 bg-[#111111] overflow-hidden">
    
    <!-- Elementos decorativos de fondo -->
    <div class="absolute top-20 right-10 w-80 h-80 bg-pink-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-purple-500/5 rounded-full blur-3xl"></div>

    <div class="relative container mx-auto px-6">

        <!-- Header de la sección -->
        <div class="text-center mb-20">
            <span class="inline-block text-pink-400 text-sm font-bold tracking-[0.3em] uppercase mb-4 font-montserrat">
                Los rostros detrás de la música
            </span>
            <h2 class="text-5xl md:text-7xl font-bold text-white italic tracking-wider font-auriol mb-4">
                Conoce la Banda
            </h2>
            <div class="w-24 h-1 bg-linear-to-r from-pink-500 to-purple-500 mx-auto rounded-full"></div>
            <p class="text-gray-400 text-lg mt-6 max-w-2xl mx-auto">
                Conoce a los artistas que dan vida a cada canción con pasión y dedicación
            </p>
        </div>

        <!-- Grid de miembros -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">
            {sortedTeamMembers.map((member, index) => (
                <div 
                    class="group relative"
                    style={`animation-delay: ${index * 150}ms`}
                >
                    <!-- Glow effect -->
                    <div class="absolute -inset-2 bg-linear-to-r from-pink-500/20 via-purple-500/20 to-blue-500/20 rounded-[45px] blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    
                    <div class="relative bg-white/5 backdrop-blur-sm rounded-[40px] p-5 border border-white/10 hover:border-white/30 transition-all duration-500 hover:transform hover:scale-[1.02]">
                        
                        <!-- Imagen del miembro -->
                        <div class="relative w-full aspect-square overflow-hidden rounded-[30px] mb-6">
                            <img 
                                src={member.photo} 
                                alt={`${member.name} - ${member.role} de la banda Owen`} 
                                class="w-full h-full object-cover transition-all duration-500 group-hover:scale-110"
                                loading="lazy"
                                width="400"
                                height="400"
                            />
                            
                            <!-- Overlay gradiente -->
                            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
                            
                            <!-- Role badge -->
                            {/* Badge movido a la sección de stats */}
                            
                            <!-- Glass Overlay for Instagram -->
                            <div class="absolute bottom-4 left-4 right-4 glass rounded-2xl p-4 flex items-center justify-between border border-white/20 shadow-2xl transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-linear-to-r from-pink-500 via-purple-500 to-orange-500 rounded-xl flex items-center justify-center">
                                        <i class="ri-instagram-line text-xl text-white" aria-hidden="true"></i>
                                    </div>
                                    <div>
                                        <span class="text-white font-bold text-sm block">@{member.instagram}</span>
                                    </div>
                                </div>
                                <a 
                                    href={`https://instagram.com/${member.instagram}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-10 h-10 bg-white/20 hover:bg-white/30 rounded-xl flex items-center justify-center transition-colors"
                                    aria-label={`Ver perfil de ${member.name}`}
                                >
                                    <i class="ri-arrow-right-up-line text-white text-lg" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Info del miembro -->
                        <div class="px-2 space-y-4">
                            <!-- Nombre y verificado -->
                            <div class="flex items-center gap-2">
                                <h3 class="text-2xl font-black text-white group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-linear-to-r group-hover:from-pink-400 group-hover:to-purple-400 transition-all duration-300">
                                    {member.name}
                                </h3>
                                <div class="w-6 h-6 bg-linear-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center">
                                    <i class="ri-check-line text-white text-sm" aria-hidden="true"></i>
                                </div>
                            </div>

                            <!-- Bio -->
                            <p class="text-gray-400 text-sm leading-relaxed line-clamp-2">
                                {member.bio}
                            </p>

                            <!-- Stats mini -->
                            <div class="flex items-center gap-4 py-3 border-t border-white/10">
                                <div class="flex items-center gap-2 text-gray-400">
                                    <i class="ri-music-2-line text-pink-400" aria-hidden="true"></i>
                                    <span class="text-xs">Artista</span>
                                </div>
                                <div class="bg-linear-to-r from-pink-600 to-purple-600 text-white text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider">
                                    {member.role}
                                </div>
                            </div>

                            <!-- Botón de seguir -->
                            <a 
                                href={`https://instagram.com/${member.instagram}`} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="w-full bg-linear-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white py-4 rounded-2xl font-bold text-sm uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-3 hover:shadow-lg hover:shadow-pink-500/25 hover:scale-[1.02] active:scale-95"
                                aria-label={`Seguir a ${member.name} en Instagram`}
                            >
                                <i class="ri-instagram-line text-lg" aria-hidden="true"></i>
                                Seguir en Instagram
                                <i class="ri-arrow-right-line text-lg" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- CTA final -->
        <div class="mt-20 text-center">
            <div class="inline-flex items-center gap-4 bg-white/5 backdrop-blur-sm border border-white/10 rounded-full px-8 py-4">
                <span class="text-gray-400">¿Quieres conocernos más?</span>
                <a 
                    href="https://www.instagram.com/owenmusicrd/" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-linear-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white px-6 py-2 rounded-full font-bold text-sm transition-all duration-300 hover:scale-105 flex items-center gap-2"
                >
                    <i class="ri-instagram-line" aria-hidden="true"></i>
                    @owenmusicrd
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Animación de entrada escalonada */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .group {
        animation: fadeInUp 0.6s ease-out forwards;
    }
</style>